# PostgreSQL connection string used by Prisma (see prisma/schema.prisma)
# Note: on Neon/PgBouncer-pooled setups, run `prisma migrate deploy`
# against the non-pooled connection string (no "-pooler" suffix) instead
# of this one — the pooler can time out on the advisory lock migrations use.
DATABASE_URL="postgresql://user:password@localhost:5432/rankvault"

# Secret used to sign NextAuth JWTs — generate with `openssl rand -base64 32`
NEXTAUTH_SECRET=""

# Must match the origin your dev server actually runs on. Without this,
# NextAuth silently falls back to http://localhost:3000 for sign-out/sign-in
# redirects, which breaks them whenever `next dev` picks a different port.
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth client, from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend API key, from https://resend.com/api-keys — order confirmation emails
# are skipped (not an error) when this is unset.
RESEND_API_KEY=""

# Must be on a domain verified in Resend (https://resend.com/domains).
# Falls back to Resend's shared test address if unset.
RESEND_FROM_EMAIL="SmurfRank <orders@yourdomain.com>"

# Inbox that receives new buyer/seller inquiry notifications. Notifications
# are skipped (not an error) when this is unset.
ADMIN_NOTIFICATION_EMAIL=""
